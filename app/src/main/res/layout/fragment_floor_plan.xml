<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white">

        <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">


                <LinearLayout
                    android:id="@+id/llCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/_10sdp"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/rounded_red_strok_bg"
                        android:text="@string/filterbycateory"
                        android:textColor="@color/black"
                        android:padding="@dimen/_5sdp"
                        android:textSize="@dimen/small" />
                    <TextView
                        android:id="@+id/tvReset"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/rounded_red_btn_bg"
                        android:padding="@dimen/_5sdp"
                        android:text="@string/reset"
                        android:layout_marginStart="@dimen/_10sdp"
                        android:textColor="@color/white"
                        android:textSize="@dimen/small" />



                </LinearLayout>


                <androidx.recyclerview.widget.RecyclerView
                    android:layout_below="@+id/llCategory"
                    android:id="@+id/rvFloor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:listitem="@layout/item_floor"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>


                <ProgressBar
                    android:id="@+id/progresbar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:visibility="gone" />

                <TextView
                    android:layout_below="@id/llCategory"
                    android:id="@+id/tvNotFound"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:background="@color/darkgrey"
                    android:gravity="center"
                    android:padding="12dp"
                    android:layout_marginTop="@dimen/_80sdp"
                    android:text="@string/no_property_available"
                    android:textColor="@color/white"
                    android:textSize="@dimen/medium"
                    android:visibility="gone" />

            </RelativeLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
