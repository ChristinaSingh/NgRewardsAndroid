<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">






        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_85sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:background="@color/white"
            >


            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="@dimen/_7sdp"
                >







            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:orientation="vertical"
                android:layout_toStartOf="@+id/cardProperty"
                >


                <main.com.ngrewards.fonttypeclasses.BoldTextView
                    android:id="@+id/tvName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/black"
                    android:textSize="@dimen/medium"
                    android:textStyle="bold" />

                <main.com.ngrewards.fonttypeclasses.NoramlTextView
                    android:id="@+id/tvDes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"

                    android:text="0.00"
                    android:textColor="@color/black"
                    android:textSize="@dimen/small" />


                <main.com.ngrewards.fonttypeclasses.NoramlTextView
                    android:id="@+id/tvPrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:text="5.55"
                    android:textColor="@color/pinkborder"
                    android:textSize="@dimen/small" />
            </LinearLayout>


            <androidx.cardview.widget.CardView
                android:id="@+id/cardProperty"
                android:layout_width="@dimen/_65sdp"
                android:layout_height="@dimen/_65sdp"
                android:layout_toStartOf="@+id/ivMore"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginEnd="@dimen/_5sdp"
                app:cardCornerRadius="@dimen/_4sdp">

                <ImageView
                    android:id="@+id/ivProperty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_centerInParent="true"
                    android:background="@color/white"
                    android:scaleType="fitXY"
                    android:src="@drawable/placeholder"
                    />

            </androidx.cardview.widget.CardView>




            <ImageView
                android:id="@+id/ivMore"
                android:layout_width="@dimen/_25sdp"
                android:layout_height="@dimen/_30sdp"
                android:src="@drawable/ic_more_vert_black_24dp"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="-5dp"
                android:layout_marginEnd="-5dp"/>
            </RelativeLayout>

            <View
                android:id="@+id/viewOverlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#80000000"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="#80000000"
                android:layout_alignParentBottom="true"/>

        </RelativeLayout>


</layout>
