<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools">


<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginTop="@dimen/_5sdp"
    >
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:padding="@dimen/_10sdp"
        >





        <androidx.cardview.widget.CardView
            android:id="@+id/cardProperty"
            android:layout_width="@dimen/_75sdp"
            android:layout_height="@dimen/_83sdp"
            android:layout_marginEnd="@dimen/_10sdp"
            app:cardCornerRadius="@dimen/_4sdp">

            <ImageView
                android:id="@+id/ivProperty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_centerInParent="true"
                android:background="@color/white"
                android:scaleType="fitXY"
                android:src="@drawable/placeholder"
                />

        </androidx.cardview.widget.CardView>





        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:orientation="vertical"
            android:layout_toEndOf="@+id/cardProperty"
            >


            <main.com.ngrewards.fonttypeclasses.BoldTextView
                android:id="@+id/tvName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:layout_marginStart="@dimen/_2sdp"
                android:textColor="@color/black"
                android:textSize="@dimen/medium"
                android:textStyle="bold" />

            <main.com.ngrewards.fonttypeclasses.NoramlTextView
                android:id="@+id/tvDes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.00"
                android:layout_marginStart="@dimen/_2sdp"
                android:textColor="@color/black"
                android:textSize="@dimen/small" />


            <main.com.ngrewards.fonttypeclasses.NoramlTextView
                android:id="@+id/tvPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="5.55"
                android:layout_marginStart="@dimen/_2sdp"
                android:textColor="@color/pinkborder"
                android:textSize="@dimen/small" />

            <Button
                android:id="@+id/btnShowDetails"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_30sdp"
                android:background="@drawable/rounded_red_btn_bg"
                android:text="@string/show_detail"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:layout_marginBottom="1dp"
                android:layout_marginTop="10dp"/>




        </LinearLayout>






    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#80000000"
        android:layout_marginTop="@dimen/_3sdp"
       />
</LinearLayout>










    </layout>

